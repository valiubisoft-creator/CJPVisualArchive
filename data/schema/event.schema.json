{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://cjp-video-wall/event.schema.json",
	"title": "CJP Protest Video Wall — event record",
	"description": "One curated clip. Embedded by youtube_id, never rehosted. The array of these in events.json is the single source of truth.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"id",
		"youtube_id",
		"title",
		"channel",
		"source_type",
		"verification_status",
		"added_by",
		"added_at"
	],
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^evt_[0-9]{4,}$",
			"description": "Stable id, e.g. evt_0001."
		},
		"youtube_id": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{11}$",
			"description": "11-char YouTube video id (embed target)."
		},
		"title": { "type": "string", "minLength": 1 },
		"channel": { "type": "string" },
		"published_at": {
			"type": ["string", "null"],
			"format": "date-time",
			"description": "Upload time from videos.list snippet.publishedAt."
		},
		"date_claimed": {
			"type": ["string", "null"],
			"format": "date",
			"description": "Curator-set event date (not upload date)."
		},
		"location_claimed": { "type": ["string", "null"] },
		"theme": {
			"type": "array",
			"items": { "type": "string" },
			"description": "Manual theme tags. Filter UI for these is deferred to a later launch."
		},
		"source_type": {
			"type": "string",
			"enum": ["citizen", "mainstream-media", "party-channel"]
		},
		"verification_status": {
			"type": "string",
			"enum": ["confirmed", "reported", "recycled-footage", "unverified"]
		},
		"verification_notes": { "type": "string" },
		"graphic_content": {
			"type": "boolean",
			"description": "If true, the tile facade is held behind a click-to-reveal interstitial.",
			"default": false
		},
		"reposted_from": {
			"type": ["string", "null"],
			"description": "youtube_id or URL this clip was reposted from (v2 network seed). Null if original/unknown."
		},
		"added_by": { "type": "string", "minLength": 1 },
		"added_at": { "type": "string", "format": "date-time" },

		"_duration_seconds": {
			"type": ["number", "null"],
			"description": "Machine-derived from videos.list contentDetails.duration. Non-authoritative."
		},
		"_thumbnail": {
			"type": ["string", "null"],
			"format": "uri",
			"description": "Machine-derived thumbnail URL. Falls back to img.youtube.com convention if absent."
		},
		"_view_count": { "type": ["number", "null"] },
		"_embeddable": {
			"type": ["boolean", "null"],
			"description": "videos.list status.embeddable at ingest time (authoritative embeddability)."
		},

		"_channel_id": { "type": ["string", "null"], "description": "Join key to channels.json." },
		"_category_id": { "type": ["string", "null"], "description": "YouTube categoryId; decode via ref/categories.json." },
		"_default_audio_language": { "type": ["string", "null"] },
		"_definition": { "type": ["string", "null"], "enum": ["hd", "sd", null] },
		"_caption": { "type": ["boolean", "null"], "description": "Whether a caption track exists (not the text)." },
		"_license": { "type": ["string", "null"], "enum": ["youtube", "creativeCommon", null] },
		"_age_restricted": { "type": ["boolean", "null"] },
		"_region_restriction": {
			"type": ["object", "null"],
			"description": "Geo-block footprint (censorship signal): { allowed?, blocked? } ISO-3166.",
			"additionalProperties": true
		},
		"_topic_categories": { "type": "array", "items": { "type": "string" } },
		"_live_actual_start": { "type": ["string", "null"], "format": "date-time" },
		"_live_actual_end": { "type": ["string", "null"], "format": "date-time" },
		"_stats": {
			"type": ["object", "null"],
			"description": "Aggregate counts only (no comment text/authors). Latest snapshot; time series lives in stats_snapshots.jsonl.",
			"additionalProperties": false,
			"properties": {
				"views": { "type": ["number", "null"] },
				"likes": { "type": ["number", "null"] },
				"comments": { "type": ["number", "null"] }
			}
		},

		"_footage_cluster_id": {
			"type": ["string", "null"],
			"description": "Derived shared-footage cluster (derive-network.mjs). Connected component over DSV edges."
		},
		"_reposted_from_inferred": {
			"type": ["string", "null"],
			"description": "Machine-inferred original youtube_id (vs curator-authoritative reposted_from). Never overwrites the human field."
		},
		"_thumbnail_pdq": {
			"type": ["string", "null"],
			"description": "Perceptual hash of the thumbnail/storyboard (hex) for repost matching. Derived; media itself never stored."
		},

		"facets": {
			"type": "object",
			"additionalProperties": false,
			"description": "Human-confirmed faceted tags. Values are validated against vocab.json by validate.mjs (single source of truth for the controlled vocabularies). See docs/TAXONOMY.md.",
			"properties": {
				"action": { "type": ["string", "null"], "description": "F1 primary action/event." },
				"actors": { "type": "array", "items": { "type": "string" }, "description": "F2 role/type only." },
				"issues": { "type": "array", "items": { "type": "string" }, "description": "F3 CJP issue/theme." },
				"setting": { "type": ["string", "null"], "description": "F4 setting." },
				"media_format": { "type": "array", "items": { "type": "string" }, "description": "F5 format." },
				"content_warnings": { "type": "array", "items": { "type": "string" } },
				"sensitivity": { "type": "array", "items": { "type": "string" }, "description": "F8 handling flags (gate access, not discovery)." }
			}
		},
		"geo": {
			"type": "object",
			"additionalProperties": false,
			"description": "F7 ACLED-style structured geo/time (curator-set).",
			"properties": {
				"event_date": { "type": ["string", "null"], "format": "date" },
				"date_precision": { "type": ["string", "null"] },
				"country": { "type": ["string", "null"] },
				"admin1": { "type": ["string", "null"] },
				"admin2": { "type": ["string", "null"] },
				"location": { "type": ["string", "null"] },
				"latitude": { "type": ["number", "null"] },
				"longitude": { "type": ["number", "null"] },
				"geo_precision": { "type": ["integer", "null"] },
				"geo_confidence": {
					"type": ["string", "null"],
					"enum": ["confirmed", "probable", "unconfirmed", null]
				}
			}
		}
	}
}
