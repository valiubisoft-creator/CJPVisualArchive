# Copy to .env.local (git-ignored) and fill in. Used ONLY by offline curation
# scripts (scripts/ingest.mjs) — never bundled into the static site.
#
# Google Cloud Console → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key to the YouTube Data API v3 (and, ideally, to your IP).
YT_API_KEY=
